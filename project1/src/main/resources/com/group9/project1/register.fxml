      <Button layoutX="87.0" layoutY="443.0" mnemonicParsing="false" prefHeight="41.0" prefWidth="336.0" style="-fx-background-color: #1E90FF;" text="Register" textFill="WHITE">
         <font>
            <Font name="Verdana Bold" size="14.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <Button layoutX="87.0" layoutY="499.0" mnemonicParsing="false" prefHeight="41.0" prefWidth="336.0" style="-fx-background-color: #87CEEB;" text="Cancel" textFill="WHITE">
