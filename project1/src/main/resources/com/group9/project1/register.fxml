      </Label>
      <PasswordField layoutX="86.0" layoutY="319.0" prefHeight="27.0" prefWidth="336.0" promptText="Enter Password" />
      <Label layoutX="79.0" layoutY="354.0" text=" Confirm Password" textFill="#565050">
