      <TextField layoutX="86.0" layoutY="199.0" prefHeight="27.0" prefWidth="336.0" promptText="Enter Lastname" />
      <Label layoutX="86.0" layoutY="234.0" text="Username" textFill="#565050">
         <font>
            <Font name="Verdana Bold" size="13.0" />
