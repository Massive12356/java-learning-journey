<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Hyperlink?>
<AnchorPane prefHeight="580.0" prefWidth="520.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group9.project1.RegisterController">
   <children>
