      </Label>
      <TextField layoutX="86.0" layoutY="260.0" prefHeight="27.0" prefWidth="336.0" promptText="Enter Username" />
      <Label layoutX="85.0" layoutY="295.0" text="Password" textFill="#565050">
         <font>
            <Font name="Verdana Bold" size="13.0" />
